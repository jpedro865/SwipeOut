{
  "expo": {
    "name": "SwipeOut",
    "slug": "swipeout",
    "scheme": "swipeout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.swipeout",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "app.swipeout",
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"],
      "adaptiveIcon": {
        "backgroundColor": "#171627",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#171627"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "SwipeOut shows your photos one at a time so you can keep them or mark them for deletion. Photos never leave your device, and nothing is deleted until you confirm.",
          "savePhotosPermission": false,
          "preventAutomaticLimitedAccessAlert": true,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "sounds": ["./assets/sounds/reminder.wav"],
          "icon": "./assets/notification-icon.png",
          "color": "#FF6B55"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": false,
          "supportedLocales": ["en", "fr"]
        }
      ]
    ],
    "locales": {
      "fr": "./assets/locales/fr.json"
    }
  }
}
