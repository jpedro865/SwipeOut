{
  "expo": {
    "name": "SwipeOut",
    "slug": "swipeout",
    "scheme": "swipeout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.swipeout"
    },
    "android": {
      "package": "app.swipeout",
      "adaptiveIcon": {
        "backgroundColor": "#171627",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#171627"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "SwipeOut shows your photos one at a time so you can keep them or mark them for deletion. Photos never leave your device, and nothing is deleted until you confirm.",
          "savePhotosPermission": false,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ]
  }
}
